      "type": "feat",
      "system": {
        "description": {
          "value": "<p>A creature starting its turn in the swarm's space takes 7 (2d6) slashing damage, and nonmetallic armor worn takes a cumulative -1 AC penalty (max -3) until repaired. Unattended rope, sailcloth, and leather in the space take 7 damage per round.</p>"
        },
        "identifier": "abrasion",
