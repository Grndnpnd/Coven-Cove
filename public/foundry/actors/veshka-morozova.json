    {
      "name": "Masthead Staff (Graystaff Magic)",
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>Her staff is a spellcasting focus. Its bells ring when a creature within 30 feet deliberately lies (only Veshka hears them unless she wills otherwise). While she holds it, her innate spellcasting expands as below; without it she loses the 1/day spells and <em>ray of frost</em>.</p>"
        },
        "identifier": "masthead-staff-(graystaff-magic)",
        "activities": {},
        "uses": {
          "max": "",
          "spent": 0,
          "recovery": []
        }
      }
    },
    {
      "name": "Innate Spellcasting",
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>Veshka's innate spellcasting ability is Charisma (spell save DC 16, +8 to hit with spell attacks). She can innately cast the following spells, requiring no material components: At will: <em>ray of frost</em> (2d8 + 4 cold and speed reduced 10 ft.); 3/day each: <em>fog cloud</em>, <em>sleet storm</em>; 1/day each (staff only): <em>ice storm</em>, <em>wall of ice</em>, <em>cone of cold</em>.</p>"
        },
        "identifier": "innate-spellcasting",
        "activities": {},
        "uses": {
          "max": "",
          "spent": 0,
          "recovery": []
        }
      }
    },
